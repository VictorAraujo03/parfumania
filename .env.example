# Copie para .env.local e ajuste conforme necessário.
# Nenhuma variável é obrigatória: a aplicação funciona sem elas.

# Caminho-base para publicação em subdiretório (ex.: GitHub Pages).
# Exemplo para https://usuario.github.io/parfumania/ -> /parfumania/
VITE_BASE_PATH=/

# Liga/desliga a integração meteorológica (Open-Meteo, sem chave).
VITE_WEATHER_ENABLED=true

# Login e banco na nuvem (Supabase). Com as duas preenchidas, o login passa a ser
# obrigatório e os dados ficam na conta. Sem elas, o app roda em modo local.
# Use SOMENTE a chave pública (anon / publishable) — nunca a service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ATENÇÃO: variáveis VITE_* são embutidas no bundle do navegador.
# Nunca coloque chaves secretas aqui. Provedores que exigem chave secreta
# devem ser acessados por uma função de servidor (ver README).
